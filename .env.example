# ==========================================
# WarrantyEase Environment Configuration
# AntiDeploy Platform & Cloud Services
# ==========================================

# Port & Runtime
PORT=3000
NODE_ENV=production

# Database (AntiDeploy Managed PostgreSQL)
# Format: postgres://username:password@host:5432/database
DATABASE_URL="postgres://postgres:password@localhost:5432/warrantyease"

# Object Storage (AntiDeploy Private S3 Bucket)
# Path-style private object storage for invoice PDFs and receipts
S3_ENDPOINT="https://s3.antideploy.com"
S3_BUCKET_NAME="warrantyease-invoices"
S3_ACCESS_KEY_ID="your_antideploy_s3_key_id"
S3_SECRET_ACCESS_KEY="your_antideploy_s3_secret_key"
S3_REGION="us-east-1"

# Clerk Authentication
# Obtain these from your Clerk dashboard (https://dashboard.clerk.com)
CLERK_SECRET_KEY="sk_test_..."
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."

# Session / JWT Fallback Secret (for local evaluation and dev preview)
JWT_SECRET="warrantyease_production_session_jwt_secret_998811"

# Scheduled Cron Secret (AntiDeploy cron trigger verification)
CRON_SECRET="warrantyease_antideploy_cron_secret_7722"

# Gemini AI (Platform injected)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
