# Runtime
PORT=4000
NODE_ENV=development

# PostgreSQL (AntiDeploy injects DATABASE_URL + PG* in the deployed container)
DATABASE_URL="postgres://user:password@host:5432/dbname"
PGSSLMODE=require

# Private S3-compatible object storage (AntiDeploy injects these in the container)
AWS_ENDPOINT_URL_S3="https://<bucket-endpoint>"
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
BUCKET_NAME="app.files"

# Clerk authentication. The platform does not provide Clerk: set your own keys.
# Leave CLERK_SECRET_KEY empty to run the gated local-session fallback instead.
CLERK_SECRET_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""

# Generated by the platform in the deployed container; set your own locally.
JWT_SECRET=""
APP_URL="http://localhost:4000"

# Guards POST|GET /api/v1/cron/reminders. The endpoint is closed when unset.
CRON_SECRET=""

# Optional: enables the demo account endpoint.
DEMO_MODE=false
ALLOW_LOCAL_AUTH=true
